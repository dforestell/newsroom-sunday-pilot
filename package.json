{
  "name": "newsroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43147 --hostname 0.0.0.0",
    "build": "npm run check:stories && npm run check:calls && next build",
    "start": "next start --port 43147 --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/nfl/*.test.ts tests/*.test.ts tests/*.test.tsx",
    "check:stories": "node --import tsx scripts/check-stories.ts",
    "check:calls": "node --import tsx scripts/check-calls.ts",
    "test:nfl": "node --experimental-strip-types --test tests/nfl/*.test.ts",
    "smoke:espn": "node --experimental-strip-types scripts/smoke-espn.ts",
    "smoke:failover": "node --experimental-strip-types scripts/smoke-failover.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
